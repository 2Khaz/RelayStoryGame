{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relay-story-game",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "STORY_ROOM",
        "class_name": "StoryRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["StoryRoom"]
    }
  ]
}
